# URL da API (Railway) — usada só pelo proxy same-origin do Next (next.config.js
# rewrites /api/* pra cá, servidor-a-servidor). NÃO precisa de NEXT_PUBLIC_ porque
# o navegador nunca chama isso direto — só fala com o próprio domínio (/api/*),
# o que evita bloqueio de cookie cross-site (Safari ITP etc).
API_PROXY_TARGET=http://localhost:8000
