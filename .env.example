# Copie para .env e preencha. NÃO comitar .env.
SCRAPECREATORS_API_KEY=
# Só necessário com --llm (Nível 2, Haiku via Batch API):
ANTHROPIC_API_KEY=
# Opcional: sobrescreve pricing.credit_usd do yaml
CREDIT_USD=0.002
# Opcional: sobrescreve pricing.model_tier2 do yaml
MODEL_TIER2=claude-haiku-4-5
# Fase 1 — banco. Local sem docker cai em SQLite. Com docker-compose:
# DATABASE_URL=postgresql+psycopg://miner:miner@localhost:5432/tiktok_miner
# No Railway: use a var DATABASE_URL do plugin Postgres (postgres:// é normalizado).
DATABASE_URL=
# Fase 3 — CORS do frontend (Vercel). Em prod: https://seu-app.vercel.app
CORS_ORIGINS=*
# Railway: semeia o DB de keywords no 1º boot da API.
AUTO_SEED=

# --- Auth (usuário + admin) --------------------------------------------------
# OBRIGATÓRIO em produção — gere um valor forte (ex: openssl rand -hex 32).
# Sem isso, cai no default de dev (inseguro, qualquer um lendo o código forja sessão).
JWT_SECRET=
# Cookie de sessão exige HTTPS por padrão (Railway/Vercel = sempre). Só desliga (false)
# rodando local sobre http puro (sem isso o cookie nunca volta no request).
COOKIE_SECURE=true
# E-mail transacional (verificação, reset de senha) — "none" só loga, não envia de
# verdade. Trocar quando escolher o provedor (ex: resend/sendgrid).
EMAIL_PROVIDER=none
# Só necessário com EMAIL_PROVIDER=resend — pegue em resend.com/api-keys
RESEND_API_KEY=
# Sem domínio verificado, o default (onboarding@resend.dev) só entrega pro
# e-mail da própria conta Resend. Trocar depois de verificar domínio próprio.
EMAIL_FROM=LowSpy <onboarding@resend.dev>

# --- Cron interno (mineração automática) -------------------------------------
# 1x TikTok + 1x Meta/dia, dentro do próprio processo (app/scheduler.py) — mesmo
# padrão do node-cron nos outros projetos, sem depender de config no painel do
# Railway. "0" desliga (ex: rodando local pra não disparar live sem querer).
CRON_ENABLED=1
